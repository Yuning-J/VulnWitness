{
  "$defs": {
    "SearchFilters": {
      "additionalProperties": false,
      "description": "Structured constraints. Values within one field are ORed; fields are ANDed.\n\nFilters only constrain. A record that satisfies them still needs an exact-ID,\nlexical or semantic match, or a graph relation to one, to become a candidate.\nValues are kept exactly as sent. CWE IDs and severities are accepted only in\ncanonical upper case; vendors, products and purls match case-insensitively.",
      "properties": {
        "cwe_ids": {
          "default": [],
          "items": {
            "maxLength": 16,
            "pattern": "^CWE-[0-9]+$(?!\\n)",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Cwe Ids",
          "type": "array",
          "uniqueItems": true
        },
        "kev_only": {
          "default": false,
          "title": "Kev Only",
          "type": "boolean"
        },
        "origins": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VulnerabilityOrigin"
          },
          "maxItems": 20,
          "title": "Origins",
          "type": "array",
          "uniqueItems": true
        },
        "products": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f\\u202a-\\u202e\\u2066-\\u2069]*[^\\s\\x00-\\x1f\\x7f\\u202a-\\u202e\\u2066-\\u2069][^\\x00-\\x1f\\x7f\\u202a-\\u202e\\u2066-\\u2069]*$(?!\\n)",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Products",
          "type": "array",
          "uniqueItems": true
        },
        "published_years": {
          "default": [],
          "items": {
            "maximum": 9999,
            "minimum": 1999,
            "type": "integer"
          },
          "maxItems": 20,
          "title": "Published Years",
          "type": "array",
          "uniqueItems": true
        },
        "purls": {
          "default": [],
          "description": "Package URLs without version, qualifiers or subpath; match any version.",
          "items": {
            "maxLength": 512,
            "pattern": "^pkg:[A-Za-z][A-Za-z0-9.+-]*(?:/[A-Za-z0-9._~%-]*[A-Za-z0-9_~%-][A-Za-z0-9._~%-]*)+$(?!\\n)",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Purls",
          "type": "array",
          "uniqueItems": true
        },
        "severities": {
          "default": [],
          "items": {
            "enum": [
              "NONE",
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ],
            "type": "string"
          },
          "maxItems": 20,
          "title": "Severities",
          "type": "array",
          "uniqueItems": true
        },
        "vendors": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f\\u202a-\\u202e\\u2066-\\u2069]*[^\\s\\x00-\\x1f\\x7f\\u202a-\\u202e\\u2066-\\u2069][^\\x00-\\x1f\\x7f\\u202a-\\u202e\\u2066-\\u2069]*$(?!\\n)",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Vendors",
          "type": "array",
          "uniqueItems": true
        }
      },
      "title": "SearchFilters",
      "type": "object"
    },
    "VulnerabilityOrigin": {
      "description": "Where a CVE's defect lives. A CVE never describes a protocol-design flaw here.",
      "enum": [
        "implementation",
        "configuration",
        "dependency",
        "unknown"
      ],
      "title": "VulnerabilityOrigin",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "filters": {
      "$ref": "#/$defs/SearchFilters"
    },
    "graph_expand": {
      "default": false,
      "title": "Graph Expand",
      "type": "boolean"
    },
    "limit": {
      "default": 10,
      "description": "Candidates the response lists: the best-ranked of the top-k each channel cut on its own, never a complete list, and with no count of what lies beyond. A response whose channels matched more than this many, or whose lexical, semantic or graph channel returned this many, warns result_limit_reached: more matches may exist.",
      "maximum": 20,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
    },
    "query": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f\\u202a-\\u202e\\u2066-\\u2069]*$(?!\\n)",
      "title": "Query",
      "type": "string"
    },
    "semantic": {
      "default": false,
      "title": "Semantic",
      "type": "boolean"
    },
    "session_id": {
      "anyOf": [
        {
          "pattern": "^inv_[a-z2-7]{20}$(?!\\n)",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    }
  },
  "required": [
    "query"
  ],
  "title": "WorkspaceSearchRequest",
  "type": "object"
}
