{
  "$defs": {
    "ServedDataset": {
      "additionalProperties": false,
      "description": "What the deployment's CVE records and evidence are. ``cve_search_version`` is the\n``cve_search`` capability's version: equal versions name byte-for-byte equal records\nand evidence, so a set sealed under one verifies under the other.",
      "properties": {
        "cve_search_version": {
          "minLength": 1,
          "title": "Cve Search Version",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ServedDatasetKind"
        }
      },
      "required": [
        "kind",
        "cve_search_version"
      ],
      "title": "ServedDataset",
      "type": "object"
    },
    "ServedDatasetKind": {
      "enum": [
        "synthetic_fixture",
        "corpus_store"
      ],
      "title": "ServedDatasetKind",
      "type": "string"
    },
    "SessionDatasetIdentity": {
      "additionalProperties": false,
      "else": {
        "properties": {
          "store_name": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "served": {
            "properties": {
              "kind": {
                "const": "corpus_store"
              }
            }
          }
        }
      },
      "properties": {
        "corpus_content_sha256": {
          "pattern": "^[0-9a-f]{64}$(?!\\n)",
          "title": "Corpus Content Sha256",
          "type": "string"
        },
        "fight_snapshot_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$(?!\\n)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fight Snapshot Sha256"
        },
        "mitre_snapshot_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$(?!\\n)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mitre Snapshot Sha256"
        },
        "served": {
          "$ref": "#/$defs/ServedDataset"
        },
        "store_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$(?!\\n)",
          "title": "Store Manifest Sha256",
          "type": "string"
        },
        "store_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Store Name"
        }
      },
      "required": [
        "served",
        "store_name",
        "store_manifest_sha256",
        "corpus_content_sha256",
        "fight_snapshot_sha256",
        "mitre_snapshot_sha256"
      ],
      "then": {
        "properties": {
          "store_name": {
            "minLength": 1,
            "type": "string"
          }
        }
      },
      "title": "SessionDatasetIdentity",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "call_limit": {
      "default": 100,
      "maximum": 100,
      "minimum": 1,
      "title": "Call Limit",
      "type": "integer"
    },
    "contract_version": {
      "const": "2.0.0-dev.47",
      "default": "2.0.0-dev.47",
      "title": "Contract Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "pattern": "^(?:(?!0000)[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?!0000)(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$(?!\\n)",
      "title": "Created At",
      "type": "string"
    },
    "dataset": {
      "$ref": "#/$defs/SessionDatasetIdentity"
    },
    "format_version": {
      "const": 1,
      "default": 1,
      "title": "Format Version",
      "type": "integer"
    },
    "goal": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Goal"
    },
    "name": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "scope": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scope"
    }
  },
  "required": [
    "format_version",
    "name",
    "created_at",
    "goal",
    "scope",
    "dataset",
    "contract_version",
    "call_limit"
  ],
  "title": "SessionRecord",
  "type": "object"
}
