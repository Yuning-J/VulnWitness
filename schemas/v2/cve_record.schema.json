{
  "$defs": {
    "AffectedProduct": {
      "additionalProperties": false,
      "properties": {
        "cpe": {
          "anyOf": [
            {
              "pattern": "^cpe:2\\.3:",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpe"
        },
        "product": {
          "minLength": 1,
          "title": "Product",
          "type": "string"
        },
        "purl": {
          "anyOf": [
            {
              "pattern": "^pkg:",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purl"
        },
        "status": {
          "enum": [
            "affected",
            "unaffected",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "vendor": {
          "minLength": 1,
          "title": "Vendor",
          "type": "string"
        },
        "version_ranges": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VersionRange"
          },
          "title": "Version Ranges",
          "type": "array"
        }
      },
      "required": [
        "vendor",
        "product",
        "cpe",
        "purl",
        "status",
        "version_ranges"
      ],
      "title": "AffectedProduct",
      "type": "object"
    },
    "CnvdEntry": {
      "additionalProperties": false,
      "properties": {
        "cnvd_id": {
          "pattern": "^CNVD-[0-9]{4}-[0-9]{4,6}$(?!\\n)",
          "title": "Cnvd Id",
          "type": "string"
        },
        "description": {
          "description": "CNVD's Chinese description; untrusted source text.",
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^ev:[0-9a-f]{24}$(?!\\n)",
          "title": "Evidence Id",
          "type": "string"
        },
        "handling_advice": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CNVD's formalWay; verbatim, untrusted source text.",
          "title": "Handling Advice"
        },
        "open_time": {
          "anyOf": [
            {
              "format": "date",
              "pattern": "^(?:(?!0000)[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?!0000)(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)$(?!\\n)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CNVD's openTime calendar date, as given; not a publication date.",
          "title": "Open Time"
        },
        "products": {
          "default": [],
          "description": "CNVD's verbatim product text; untrusted source text.",
          "items": {
            "type": "string"
          },
          "title": "Products",
          "type": "array"
        },
        "severity": {
          "description": "CNVD's severity: high for 高, medium for 中, low for 低.",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Severity",
          "type": "string"
        },
        "submit_time": {
          "anyOf": [
            {
              "format": "date",
              "pattern": "^(?:(?!0000)[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?!0000)(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)$(?!\\n)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CNVD's submitTime calendar date, as given.",
          "title": "Submit Time"
        },
        "title": {
          "description": "CNVD's Chinese title; untrusted source text.",
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "cnvd_id",
        "title",
        "description",
        "severity",
        "products",
        "submit_time",
        "open_time",
        "handling_advice",
        "evidence_id"
      ],
      "title": "CnvdEntry",
      "type": "object"
    },
    "CveTag": {
      "additionalProperties": false,
      "description": "A CVE-format ``cveTags`` entry, e.g. ``disputed`` or ``unsupported-when-assigned``.",
      "properties": {
        "source": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "source",
        "tags"
      ],
      "title": "CveTag",
      "type": "object"
    },
    "CvssMetric": {
      "additionalProperties": false,
      "properties": {
        "base_score": {
          "maximum": 10.0,
          "minimum": 0.0,
          "title": "Base Score",
          "type": "number"
        },
        "base_severity": {
          "anyOf": [
            {
              "enum": [
                "NONE",
                "LOW",
                "MEDIUM",
                "HIGH",
                "CRITICAL"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Severity"
        },
        "scorer": {
          "description": "Organization that produced this score.",
          "minLength": 1,
          "title": "Scorer",
          "type": "string"
        },
        "scorer_type": {
          "anyOf": [
            {
              "enum": [
                "primary",
                "secondary"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scorer Type"
        },
        "vector_string": {
          "minLength": 1,
          "title": "Vector String",
          "type": "string"
        },
        "version": {
          "enum": [
            "2.0",
            "3.0",
            "3.1",
            "4.0"
          ],
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "vector_string",
        "base_score",
        "base_severity",
        "scorer",
        "scorer_type"
      ],
      "title": "CvssMetric",
      "type": "object"
    },
    "KevEntry": {
      "additionalProperties": false,
      "properties": {
        "cwe_ids": {
          "default": [],
          "description": "CISA's cwes column, in catalog order (format 4).",
          "items": {
            "maxLength": 16,
            "pattern": "^CWE-[0-9]+$(?!\\n)",
            "type": "string"
          },
          "title": "Cwe Ids",
          "type": "array"
        },
        "date_added": {
          "format": "date",
          "pattern": "^(?:(?!0000)[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?!0000)(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)$(?!\\n)",
          "title": "Date Added",
          "type": "string"
        },
        "due_date": {
          "anyOf": [
            {
              "format": "date",
              "pattern": "^(?:(?!0000)[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?!0000)(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)$(?!\\n)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Due Date"
        },
        "forensic_triage": {
          "anyOf": [
            {
              "enum": [
                "yes",
                "no"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CISA's forensicTriage column, Yes or No as given; null when the consulted source does not carry it (format 4).",
          "title": "Forensic Triage"
        },
        "known_ransomware_campaign_use": {
          "anyOf": [
            {
              "enum": [
                "known",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CISA's own Known/Unknown assessment; null when the consulted source does not carry it.",
          "title": "Known Ransomware Campaign Use"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 8000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CISA's notes, usually URLs; verbatim, untrusted, never fetched (format 4).",
          "title": "Notes"
        },
        "required_action": {
          "anyOf": [
            {
              "maxLength": 8000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CISA's requiredAction; verbatim, untrusted source text (format 4).",
          "title": "Required Action"
        },
        "vulnerability_name": {
          "anyOf": [
            {
              "maxLength": 8000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CISA's vulnerabilityName; verbatim, untrusted source text (format 4).",
          "title": "Vulnerability Name"
        }
      },
      "required": [
        "date_added",
        "due_date",
        "known_ransomware_campaign_use",
        "vulnerability_name",
        "required_action",
        "notes",
        "cwe_ids",
        "forensic_triage"
      ],
      "title": "KevEntry",
      "type": "object"
    },
    "LocalizedText": {
      "additionalProperties": false,
      "properties": {
        "lang": {
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$(?!\\n)",
          "title": "Lang",
          "type": "string"
        },
        "source": {
          "description": "Who authored this text, e.g. a CNA.",
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "value": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "lang",
        "value",
        "source"
      ],
      "title": "LocalizedText",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "url": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url",
        "source",
        "tags"
      ],
      "title": "Reference",
      "type": "object"
    },
    "SourceAffected": {
      "additionalProperties": false,
      "description": "The affected data one CNA or ADP published, as NVD 2.0 mirrors it (\"CVE Affected\nv1.0\", since 2026-06-17). It is that source's statement, not NVD's analysis, and it\nnever sets affectedness.",
      "properties": {
        "omitted_products": {
          "default": 0,
          "minimum": 0,
          "title": "Omitted Products",
          "type": "integer"
        },
        "products": {
          "items": {
            "$ref": "#/$defs/SourceAffectedProduct"
          },
          "maxItems": 64,
          "title": "Products",
          "type": "array"
        },
        "source": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "products",
        "omitted_products"
      ],
      "title": "SourceAffected",
      "type": "object"
    },
    "SourceAffectedProduct": {
      "additionalProperties": false,
      "description": "One CVE-format ``affected[]`` product; vendor and product are untrusted text.",
      "properties": {
        "collection_url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Collection Url"
        },
        "cpes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Cpes",
          "type": "array"
        },
        "default_status": {
          "anyOf": [
            {
              "enum": [
                "affected",
                "unaffected",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Status"
        },
        "modules": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Modules",
          "type": "array"
        },
        "omitted_versions": {
          "default": 0,
          "minimum": 0,
          "title": "Omitted Versions",
          "type": "integer"
        },
        "package_name": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package Name"
        },
        "package_url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "pattern": "^pkg:",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package Url"
        },
        "platforms": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Platforms",
          "type": "array"
        },
        "product": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product"
        },
        "repo": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repo"
        },
        "vendor": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vendor"
        },
        "versions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceAffectedVersion"
          },
          "maxItems": 64,
          "title": "Versions",
          "type": "array"
        }
      },
      "required": [
        "vendor",
        "product",
        "package_name",
        "collection_url",
        "repo",
        "package_url",
        "cpes",
        "modules",
        "platforms",
        "default_status",
        "versions",
        "omitted_versions"
      ],
      "title": "SourceAffectedProduct",
      "type": "object"
    },
    "SourceAffectedVersion": {
      "additionalProperties": false,
      "description": "One CVE-format ``versions[]`` entry as its author gave it; nothing is compared.",
      "properties": {
        "less_than": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Less Than"
        },
        "less_than_or_equal": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Less Than Or Equal"
        },
        "status": {
          "enum": [
            "affected",
            "unaffected",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "version": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "version_type": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version Type"
        }
      },
      "required": [
        "version",
        "status",
        "version_type",
        "less_than",
        "less_than_or_equal"
      ],
      "title": "SourceAffectedVersion",
      "type": "object"
    },
    "SsvcAssessment": {
      "additionalProperties": false,
      "description": "One SSVC assessment NVD 2.0 mirrors in ``metrics.ssvcV203``; CISA's ADP container\nscores most CVEs in the role ``CISA Coordinator``.",
      "properties": {
        "assessed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^(?:(?!0000)[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?!0000)(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$(?!\\n)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assessed At"
        },
        "decision_points": {
          "$ref": "#/$defs/SsvcDecisionPoints"
        },
        "role": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "source": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "source",
        "role",
        "version",
        "assessed_at",
        "decision_points"
      ],
      "title": "SsvcAssessment",
      "type": "object"
    },
    "SsvcDecisionPoints": {
      "additionalProperties": false,
      "description": "SSVC v2.0.3 decision points as a source scored them; null when it gave none.",
      "properties": {
        "automatable": {
          "anyOf": [
            {
              "enum": [
                "yes",
                "no"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Automatable"
        },
        "exploitation": {
          "anyOf": [
            {
              "enum": [
                "none",
                "poc",
                "active"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exploitation"
        },
        "technical_impact": {
          "anyOf": [
            {
              "enum": [
                "partial",
                "total"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Technical Impact"
        }
      },
      "required": [
        "exploitation",
        "automatable",
        "technical_impact"
      ],
      "title": "SsvcDecisionPoints",
      "type": "object"
    },
    "VersionRange": {
      "additionalProperties": false,
      "description": "One affected version or bounded range; at least one bound or ``exact`` is set.",
      "oneOf": [
        {
          "properties": {
            "end_excluding": {
              "type": "null"
            },
            "end_including": {
              "type": "null"
            },
            "exact": {
              "type": "string"
            },
            "start_excluding": {
              "type": "null"
            },
            "start_including": {
              "type": "null"
            }
          },
          "required": [
            "exact"
          ]
        },
        {
          "anyOf": [
            {
              "properties": {
                "start_including": {
                  "type": "string"
                }
              },
              "required": [
                "start_including"
              ]
            },
            {
              "properties": {
                "start_excluding": {
                  "type": "string"
                }
              },
              "required": [
                "start_excluding"
              ]
            },
            {
              "properties": {
                "end_including": {
                  "type": "string"
                }
              },
              "required": [
                "end_including"
              ]
            },
            {
              "properties": {
                "end_excluding": {
                  "type": "string"
                }
              },
              "required": [
                "end_excluding"
              ]
            }
          ],
          "properties": {
            "exact": {
              "type": "null"
            }
          }
        }
      ],
      "properties": {
        "end_excluding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Excluding"
        },
        "end_including": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Including"
        },
        "exact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exact"
        },
        "start_excluding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Excluding"
        },
        "start_including": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Including"
        }
      },
      "required": [
        "exact",
        "start_including",
        "start_excluding",
        "end_including",
        "end_excluding"
      ],
      "title": "VersionRange",
      "type": "object"
    },
    "VulnerabilityOrigin": {
      "description": "Where a CVE's defect lives. A CVE never describes a protocol-design flaw here.",
      "enum": [
        "implementation",
        "configuration",
        "dependency",
        "unknown"
      ],
      "title": "VulnerabilityOrigin",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An implementation-level vulnerability record.\n\n``protocol_design_claim`` and ``formal_seed_eligible`` are fixed: a CVE never\nestablishes a protocol-design vulnerability and never seeds formal analysis.",
  "properties": {
    "affected": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AffectedProduct"
      },
      "title": "Affected",
      "type": "array"
    },
    "cnvd": {
      "default": [],
      "description": "CNVD entries ordered by CNVD ID; Chinese text is untrusted data.",
      "items": {
        "$ref": "#/$defs/CnvdEntry"
      },
      "title": "Cnvd",
      "type": "array"
    },
    "cve_id": {
      "maxLength": 32,
      "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$(?!\\n)",
      "title": "Cve Id",
      "type": "string"
    },
    "cve_tags": {
      "default": [],
      "description": "CVE-format tags NVD 2.0 mirrors, in feed order (format 4).",
      "items": {
        "$ref": "#/$defs/CveTag"
      },
      "title": "Cve Tags",
      "type": "array"
    },
    "cvss": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CvssMetric"
      },
      "title": "Cvss",
      "type": "array"
    },
    "cwe_ids": {
      "default": [],
      "items": {
        "maxLength": 16,
        "pattern": "^CWE-[0-9]+$(?!\\n)",
        "type": "string"
      },
      "title": "Cwe Ids",
      "type": "array"
    },
    "descriptions": {
      "items": {
        "$ref": "#/$defs/LocalizedText"
      },
      "minItems": 1,
      "title": "Descriptions",
      "type": "array"
    },
    "evidence_ids": {
      "items": {
        "pattern": "^ev:[0-9a-f]{24}$(?!\\n)",
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Ids",
      "type": "array"
    },
    "formal_seed_eligible": {
      "const": false,
      "default": false,
      "title": "Formal Seed Eligible",
      "type": "boolean"
    },
    "kev": {
      "anyOf": [
        {
          "$ref": "#/$defs/KevEntry"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "CISA KEV entry, when a consulted source lists one."
    },
    "last_modified": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "^(?:(?!0000)[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?!0000)(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$(?!\\n)",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Modified"
    },
    "nvd_status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "NVD 2.0 vulnStatus verbatim, untrusted source text; null for NVD 1.1 and synthetic data.",
      "title": "Nvd Status"
    },
    "protocol_design_claim": {
      "const": "not_established",
      "default": "not_established",
      "title": "Protocol Design Claim",
      "type": "string"
    },
    "published": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "^(?:(?!0000)[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?!0000)(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$(?!\\n)",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Published"
    },
    "record_kind": {
      "const": "cve",
      "default": "cve",
      "title": "Record Kind",
      "type": "string"
    },
    "references": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "title": "References",
      "type": "array"
    },
    "source_affected": {
      "default": [],
      "description": "CNA and ADP affected data NVD 2.0 mirrors, one block per source in feed order; untrusted source statements, not NVD analysis (format 4).",
      "items": {
        "$ref": "#/$defs/SourceAffected"
      },
      "title": "Source Affected",
      "type": "array"
    },
    "ssvc": {
      "default": [],
      "description": "SSVC assessments NVD 2.0 mirrors, in feed order (format 4).",
      "items": {
        "$ref": "#/$defs/SsvcAssessment"
      },
      "title": "Ssvc",
      "type": "array"
    },
    "vulnerability_origin": {
      "$ref": "#/$defs/VulnerabilityOrigin",
      "default": "unknown"
    }
  },
  "required": [
    "record_kind",
    "cve_id",
    "descriptions",
    "published",
    "last_modified",
    "cvss",
    "cwe_ids",
    "affected",
    "references",
    "kev",
    "nvd_status",
    "source_affected",
    "ssvc",
    "cve_tags",
    "cnvd",
    "vulnerability_origin",
    "protocol_design_claim",
    "formal_seed_eligible",
    "evidence_ids"
  ],
  "title": "CveRecord",
  "type": "object"
}
