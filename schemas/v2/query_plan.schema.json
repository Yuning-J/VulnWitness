{
  "$defs": {
    "CveExactLookupCall": {
      "additionalProperties": false,
      "properties": {
        "cve_ids": {
          "items": {
            "maxLength": 32,
            "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$(?!\\n)",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Cve Ids",
          "type": "array"
        },
        "tool": {
          "const": "cve_exact_lookup",
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "cve_ids"
      ],
      "title": "CveExactLookupCall",
      "type": "object"
    },
    "CveSearchCall": {
      "additionalProperties": false,
      "properties": {
        "query": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "tool": {
          "const": "cve_search",
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "query"
      ],
      "title": "CveSearchCall",
      "type": "object"
    },
    "FightDirectSearchCall": {
      "additionalProperties": false,
      "description": "One MITRE FiGHT search with the question's own words, when no topic resolved. It\ntakes no arguments, so no planner chooses its words: the interpretation's\n``fight_terms`` are what it sends.",
      "properties": {
        "tool": {
          "const": "fight_direct_search",
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool"
      ],
      "title": "FightDirectSearchCall",
      "type": "object"
    },
    "ProductQueryCall": {
      "additionalProperties": false,
      "properties": {
        "recognition": {
          "$ref": "#/$defs/ProductRecognition"
        },
        "tool": {
          "const": "product_query",
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "recognition"
      ],
      "title": "ProductQueryCall",
      "type": "object"
    },
    "ProductQueryRequest": {
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "vendor": {
              "type": "string"
            }
          },
          "required": [
            "vendor"
          ]
        },
        {
          "properties": {
            "product": {
              "type": "string"
            }
          },
          "required": [
            "product"
          ]
        }
      ],
      "description": "At least one whole vendor or product name; version is never search text.",
      "properties": {
        "cursor": {
          "anyOf": [
            {
              "maxLength": 8192,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Opaque continuation from next_cursor; pass unchanged with the same vendor, product, version and limit against the same served corpus.",
          "title": "Cursor"
        },
        "limit": {
          "default": 20,
          "maximum": 20,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "product": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[^\\x00-\\x1f\\x7f\\u202a-\\u202e\\u2066-\\u2069]*[^\\s\\x00-\\x1f\\x7f\\u202a-\\u202e\\u2066-\\u2069][^\\x00-\\x1f\\x7f\\u202a-\\u202e\\u2066-\\u2069]*$(?!\\n)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact CPE product name, case-folded; punctuation and whitespace retained.",
          "title": "Product"
        },
        "vendor": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[^\\x00-\\x1f\\x7f\\u202a-\\u202e\\u2066-\\u2069]*[^\\s\\x00-\\x1f\\x7f\\u202a-\\u202e\\u2066-\\u2069][^\\x00-\\x1f\\x7f\\u202a-\\u202e\\u2066-\\u2069]*$(?!\\n)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact CPE vendor name, case-folded; punctuation and whitespace retained.",
          "title": "Vendor"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[^\\x00-\\x1f\\x7f\\u202a-\\u202e\\u2066-\\u2069]*[^\\s\\x00-\\x1f\\x7f\\u202a-\\u202e\\u2066-\\u2069][^\\x00-\\x1f\\x7f\\u202a-\\u202e\\u2066-\\u2069]*$(?!\\n)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "title": "ProductQueryRequest",
      "type": "object"
    },
    "ProductRecognition": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": [
            "affectedness_mention",
            "exact_phrase"
          ],
          "title": "Basis",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/ProductQueryRequest"
        }
      },
      "required": [
        "name",
        "basis",
        "request"
      ],
      "title": "ProductRecognition",
      "type": "object"
    },
    "TopicContextCall": {
      "additionalProperties": false,
      "properties": {
        "tool": {
          "const": "topic_context",
          "title": "Tool",
          "type": "string"
        },
        "topic_id": {
          "pattern": "^[a-z0-9]+:[a-z0-9][a-z0-9-]*$(?!\\n)",
          "title": "Topic Id",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "topic_id"
      ],
      "title": "TopicContextCall",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The only shape a model planner may emit.",
  "properties": {
    "steps": {
      "items": {
        "discriminator": {
          "mapping": {
            "cve_exact_lookup": "#/$defs/CveExactLookupCall",
            "cve_search": "#/$defs/CveSearchCall",
            "fight_direct_search": "#/$defs/FightDirectSearchCall",
            "product_query": "#/$defs/ProductQueryCall",
            "topic_context": "#/$defs/TopicContextCall"
          },
          "propertyName": "tool"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/CveExactLookupCall"
          },
          {
            "$ref": "#/$defs/CveSearchCall"
          },
          {
            "$ref": "#/$defs/ProductQueryCall"
          },
          {
            "$ref": "#/$defs/TopicContextCall"
          },
          {
            "$ref": "#/$defs/FightDirectSearchCall"
          }
        ]
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "steps"
  ],
  "title": "QueryPlan",
  "type": "object"
}
