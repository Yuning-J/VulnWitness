{
  "$defs": {
    "CnvdEntry": {
      "additionalProperties": false,
      "properties": {
        "cnvd_id": {
          "pattern": "^CNVD-[0-9]{4}-[0-9]{4,6}$(?!\\n)",
          "title": "Cnvd Id",
          "type": "string"
        },
        "description": {
          "description": "CNVD's Chinese description; untrusted source text.",
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^ev:[0-9a-f]{24}$(?!\\n)",
          "title": "Evidence Id",
          "type": "string"
        },
        "handling_advice": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CNVD's formalWay; verbatim, untrusted source text.",
          "title": "Handling Advice"
        },
        "open_time": {
          "anyOf": [
            {
              "format": "date",
              "pattern": "^(?:(?!0000)[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?!0000)(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)$(?!\\n)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CNVD's openTime calendar date, as given; not a publication date.",
          "title": "Open Time"
        },
        "products": {
          "default": [],
          "description": "CNVD's verbatim product text; untrusted source text.",
          "items": {
            "type": "string"
          },
          "title": "Products",
          "type": "array"
        },
        "severity": {
          "description": "CNVD's severity: high for 高, medium for 中, low for 低.",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Severity",
          "type": "string"
        },
        "submit_time": {
          "anyOf": [
            {
              "format": "date",
              "pattern": "^(?:(?!0000)[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?!0000)(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)$(?!\\n)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CNVD's submitTime calendar date, as given.",
          "title": "Submit Time"
        },
        "title": {
          "description": "CNVD's Chinese title; untrusted source text.",
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "cnvd_id",
        "title",
        "description",
        "severity",
        "products",
        "submit_time",
        "open_time",
        "handling_advice",
        "evidence_id"
      ],
      "title": "CnvdEntry",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One CNVD entry whose CVE has no servable NVD record in this store.",
  "properties": {
    "cve_id": {
      "maxLength": 32,
      "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$(?!\\n)",
      "title": "Cve Id",
      "type": "string"
    },
    "entry": {
      "$ref": "#/$defs/CnvdEntry"
    },
    "outcome": {
      "enum": [
        "cnvd_without_nvd_record",
        "cnvd_for_rejected_nvd_record",
        "cnvd_for_excluded_nvd_record"
      ],
      "title": "Outcome",
      "type": "string"
    }
  },
  "required": [
    "cve_id",
    "outcome",
    "entry"
  ],
  "title": "PendingCnvdEntry",
  "type": "object"
}
