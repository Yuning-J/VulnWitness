{
  "$defs": {
    "EnrichmentCounts": {
      "additionalProperties": false,
      "properties": {
        "enriched": {
          "minimum": 0,
          "title": "Enriched",
          "type": "integer"
        },
        "not_recorded": {
          "minimum": 0,
          "title": "Not Recorded",
          "type": "integer"
        },
        "not_scheduled": {
          "minimum": 0,
          "title": "Not Scheduled",
          "type": "integer"
        },
        "pending": {
          "minimum": 0,
          "title": "Pending",
          "type": "integer"
        },
        "rejected": {
          "minimum": 0,
          "title": "Rejected",
          "type": "integer"
        },
        "unrecognised": {
          "minimum": 0,
          "title": "Unrecognised",
          "type": "integer"
        }
      },
      "required": [
        "enriched",
        "pending",
        "not_scheduled",
        "rejected",
        "unrecognised",
        "not_recorded"
      ],
      "title": "EnrichmentCounts",
      "type": "object"
    },
    "MonthCoverage": {
      "additionalProperties": false,
      "properties": {
        "enrichment": {
          "$ref": "#/$defs/EnrichmentCounts"
        },
        "kev_listed": {
          "minimum": 0,
          "title": "Kev Listed",
          "type": "integer"
        },
        "month": {
          "description": "Publication month (UTC); unpublished when the record has no date; all for the store's total.",
          "pattern": "^([0-9]{4}-[0-9]{2}|unpublished|all)$(?!\\n)",
          "title": "Month",
          "type": "string"
        },
        "nvd_status": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "Verbatim NVD 2.0 API vulnStatus counts.",
          "title": "Nvd Status",
          "type": "object"
        },
        "records": {
          "minimum": 0,
          "title": "Records",
          "type": "integer"
        },
        "ssvc_exploitation_active": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ssvc Exploitation Active"
        },
        "ssvc_exploitation_poc": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ssvc Exploitation Poc"
        },
        "with_any_cvss": {
          "minimum": 0,
          "title": "With Any Cvss",
          "type": "integer"
        },
        "with_cnvd": {
          "minimum": 0,
          "title": "With Cnvd",
          "type": "integer"
        },
        "with_cvss4": {
          "minimum": 0,
          "title": "With Cvss4",
          "type": "integer"
        },
        "with_cwe": {
          "minimum": 0,
          "title": "With Cwe",
          "type": "integer"
        },
        "with_exploit_reference": {
          "minimum": 0,
          "title": "With Exploit Reference",
          "type": "integer"
        },
        "with_nvd_own_cvss3": {
          "minimum": 0,
          "title": "With Nvd Own Cvss3",
          "type": "integer"
        },
        "with_source_affected": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Records carrying CNA or ADP affected data (store format 4).",
          "title": "With Source Affected"
        },
        "with_source_affected_purl": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "With Source Affected Purl"
        },
        "with_source_affected_versions": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Records whose CNA or ADP affected data names a version or range.",
          "title": "With Source Affected Versions"
        },
        "with_source_cvss": {
          "description": "Records with a CVSS metric not NVD's own.",
          "minimum": 0,
          "title": "With Source Cvss",
          "type": "integer"
        },
        "with_ssvc": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "With Ssvc"
        },
        "with_vulnerable_cpe": {
          "minimum": 0,
          "title": "With Vulnerable Cpe",
          "type": "integer"
        }
      },
      "required": [
        "month",
        "records",
        "nvd_status",
        "enrichment",
        "with_vulnerable_cpe",
        "with_nvd_own_cvss3",
        "with_any_cvss",
        "with_cvss4",
        "with_cwe",
        "with_exploit_reference",
        "kev_listed",
        "with_cnvd",
        "with_source_cvss",
        "with_source_affected",
        "with_source_affected_versions",
        "with_source_affected_purl",
        "with_ssvc",
        "ssvc_exploitation_poc",
        "ssvc_exploitation_active"
      ],
      "title": "MonthCoverage",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "corpus_content_sha256": {
      "pattern": "^[0-9a-f]{64}$(?!\\n)",
      "title": "Corpus Content Sha256",
      "type": "string"
    },
    "months": {
      "items": {
        "$ref": "#/$defs/MonthCoverage"
      },
      "title": "Months",
      "type": "array"
    },
    "records": {
      "minimum": 0,
      "title": "Records",
      "type": "integer"
    },
    "schema_version": {
      "const": "2.0.0-dev.61",
      "default": "2.0.0-dev.61",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_records_sha256": {
      "pattern": "^[0-9a-f]{64}$(?!\\n)",
      "title": "Semantic Records Sha256",
      "type": "string"
    },
    "statement": {
      "const": "Counts of what each record carries in this store, by publication month. Zero means no record carries the field in this snapshot; null means the store format cannot record it. Missing data never says the CVE affects nothing or is not severe.",
      "default": "Counts of what each record carries in this store, by publication month. Zero means no record carries the field in this snapshot; null means the store format cannot record it. Missing data never says the CVE affects nothing or is not severe.",
      "title": "Statement",
      "type": "string"
    },
    "store_format_version": {
      "maximum": 4,
      "minimum": 1,
      "title": "Store Format Version",
      "type": "integer"
    },
    "store_name": {
      "title": "Store Name",
      "type": "string"
    },
    "total": {
      "$ref": "#/$defs/MonthCoverage"
    }
  },
  "required": [
    "schema_version",
    "store_name",
    "store_format_version",
    "corpus_content_sha256",
    "semantic_records_sha256",
    "records",
    "months",
    "total",
    "statement"
  ],
  "title": "StoreCoverage",
  "type": "object"
}
