{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "call": {
      "maximum": 100,
      "minimum": 1,
      "title": "Call",
      "type": "integer"
    },
    "session_id": {
      "pattern": "^inv_[a-z2-7]{20}$(?!\\n)",
      "title": "Session Id",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "call"
  ],
  "title": "ReadCallRequest",
  "type": "object"
}
