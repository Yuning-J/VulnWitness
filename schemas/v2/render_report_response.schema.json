{
  "$defs": {
    "JsonValue": {},
    "SessionCheckReport": {
      "additionalProperties": false,
      "properties": {
        "citations": {
          "$ref": "#/$defs/SessionCitationCheck"
        },
        "claims": {
          "$ref": "#/$defs/SessionClaimsCheck"
        },
        "not_checked": {
          "$ref": "#/$defs/SessionNotChecked"
        },
        "record": {
          "$ref": "#/$defs/SessionRecordCheck"
        },
        "schema_version": {
          "const": "2.0.0-dev.53",
          "default": "2.0.0-dev.53",
          "title": "Schema Version",
          "type": "string"
        },
        "superseded_count": {
          "default": 0,
          "minimum": 0,
          "title": "Superseded Count",
          "type": "integer"
        },
        "support_limitation": {
          "const": "Free narrative is not checked. This check does not establish that a statement is supported by cited evidence or prove real-world truth.",
          "default": "Free narrative is not checked. This check does not establish that a statement is supported by cited evidence or prove real-world truth.",
          "title": "Support Limitation",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "record",
        "citations",
        "claims",
        "not_checked",
        "superseded_count",
        "support_limitation"
      ],
      "title": "SessionCheckReport",
      "type": "object"
    },
    "SessionCitationCheck": {
      "additionalProperties": false,
      "properties": {
        "citations_checked": {
          "minimum": 0,
          "title": "Citations Checked",
          "type": "integer"
        },
        "resolved": {
          "title": "Resolved",
          "type": "boolean"
        },
        "violations": {
          "items": {
            "$ref": "#/$defs/SessionViolation"
          },
          "title": "Violations",
          "type": "array"
        }
      },
      "required": [
        "resolved",
        "citations_checked",
        "violations"
      ],
      "title": "SessionCitationCheck",
      "type": "object"
    },
    "SessionClaimCheck": {
      "additionalProperties": false,
      "properties": {
        "call": {
          "maximum": 100,
          "minimum": 1,
          "title": "Call",
          "type": "integer"
        },
        "expected": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "recorded": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "status": {
          "enum": [
            "verified",
            "contradicted",
            "unverifiable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "call",
        "status",
        "field",
        "expected",
        "recorded",
        "message"
      ],
      "title": "SessionClaimCheck",
      "type": "object"
    },
    "SessionClaimsCheck": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/SessionClaimCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "verified": {
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "verified",
        "checks"
      ],
      "title": "SessionClaimsCheck",
      "type": "object"
    },
    "SessionNotChecked": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "title": "Finding Ids",
          "type": "array"
        }
      },
      "required": [
        "count",
        "finding_ids"
      ],
      "title": "SessionNotChecked",
      "type": "object"
    },
    "SessionRecordCheck": {
      "additionalProperties": false,
      "properties": {
        "calls_checked": {
          "minimum": 0,
          "title": "Calls Checked",
          "type": "integer"
        },
        "consistent": {
          "title": "Consistent",
          "type": "boolean"
        },
        "violations": {
          "items": {
            "$ref": "#/$defs/SessionViolation"
          },
          "title": "Violations",
          "type": "array"
        }
      },
      "required": [
        "consistent",
        "calls_checked",
        "violations"
      ],
      "title": "SessionRecordCheck",
      "type": "object"
    },
    "SessionViolation": {
      "additionalProperties": false,
      "properties": {
        "location": {
          "title": "Location",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "location",
        "message"
      ],
      "title": "SessionViolation",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "byte_size": {
      "minimum": 0,
      "title": "Byte Size",
      "type": "integer"
    },
    "check": {
      "$ref": "#/$defs/SessionCheckReport"
    },
    "input_digest": {
      "pattern": "^[0-9a-f]{64}$(?!\\n)",
      "title": "Input Digest",
      "type": "string"
    },
    "local_path": {
      "title": "Local Path",
      "type": "string"
    },
    "markdown": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Markdown"
    },
    "report": {
      "enum": [
        "none",
        "current",
        "stale"
      ],
      "title": "Report",
      "type": "string"
    },
    "resource_uri": {
      "title": "Resource Uri",
      "type": "string"
    },
    "session_id": {
      "pattern": "^inv_[a-z2-7]{20}$(?!\\n)",
      "title": "Session Id",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "resource_uri",
    "local_path",
    "byte_size",
    "input_digest",
    "report",
    "check",
    "markdown"
  ],
  "title": "RenderReportResponse",
  "type": "object"
}
