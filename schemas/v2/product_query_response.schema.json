{
  "$defs": {
    "AffectedProduct": {
      "additionalProperties": false,
      "properties": {
        "cpe": {
          "anyOf": [
            {
              "pattern": "^cpe:2\\.3:",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpe"
        },
        "product": {
          "minLength": 1,
          "title": "Product",
          "type": "string"
        },
        "purl": {
          "anyOf": [
            {
              "pattern": "^pkg:",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purl"
        },
        "status": {
          "enum": [
            "affected",
            "unaffected",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "vendor": {
          "minLength": 1,
          "title": "Vendor",
          "type": "string"
        },
        "version_ranges": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VersionRange"
          },
          "title": "Version Ranges",
          "type": "array"
        }
      },
      "required": [
        "vendor",
        "product",
        "cpe",
        "purl",
        "status",
        "version_ranges"
      ],
      "title": "AffectedProduct",
      "type": "object"
    },
    "AssertionKind": {
      "description": "Whether a source states a fact directly or this service derived it.",
      "enum": [
        "asserted",
        "inferred"
      ],
      "title": "AssertionKind",
      "type": "string"
    },
    "CnvdEntry": {
      "additionalProperties": false,
      "properties": {
        "cnvd_id": {
          "pattern": "^CNVD-[0-9]{4}-[0-9]{4,6}$(?!\\n)",
          "title": "Cnvd Id",
          "type": "string"
        },
        "description": {
          "description": "CNVD's Chinese description; untrusted source text.",
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^ev:[0-9a-f]{24}$(?!\\n)",
          "title": "Evidence Id",
          "type": "string"
        },
        "handling_advice": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CNVD's formalWay; verbatim, untrusted source text.",
          "title": "Handling Advice"
        },
        "open_time": {
          "anyOf": [
            {
              "format": "date",
              "pattern": "^(?:(?!0000)[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?!0000)(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)$(?!\\n)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CNVD's openTime calendar date, as given; not a publication date.",
          "title": "Open Time"
        },
        "products": {
          "default": [],
          "description": "CNVD's verbatim product text; untrusted source text.",
          "items": {
            "type": "string"
          },
          "title": "Products",
          "type": "array"
        },
        "severity": {
          "description": "CNVD's severity: high for 高, medium for 中, low for 低.",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Severity",
          "type": "string"
        },
        "submit_time": {
          "anyOf": [
            {
              "format": "date",
              "pattern": "^(?:(?!0000)[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?!0000)(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)$(?!\\n)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CNVD's submitTime calendar date, as given.",
          "title": "Submit Time"
        },
        "title": {
          "description": "CNVD's Chinese title; untrusted source text.",
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "cnvd_id",
        "title",
        "description",
        "severity",
        "products",
        "submit_time",
        "open_time",
        "handling_advice",
        "evidence_id"
      ],
      "title": "CnvdEntry",
      "type": "object"
    },
    "CveRecord": {
      "additionalProperties": false,
      "description": "An implementation-level vulnerability record.\n\n``protocol_design_claim`` and ``formal_seed_eligible`` are fixed: a CVE never\nestablishes a protocol-design vulnerability and never seeds formal analysis.",
      "properties": {
        "affected": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AffectedProduct"
          },
          "title": "Affected",
          "type": "array"
        },
        "cnvd": {
          "default": [],
          "description": "CNVD entries ordered by CNVD ID; Chinese text is untrusted data.",
          "items": {
            "$ref": "#/$defs/CnvdEntry"
          },
          "title": "Cnvd",
          "type": "array"
        },
        "cve_id": {
          "maxLength": 32,
          "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$(?!\\n)",
          "title": "Cve Id",
          "type": "string"
        },
        "cvss": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CvssMetric"
          },
          "title": "Cvss",
          "type": "array"
        },
        "cwe_ids": {
          "default": [],
          "items": {
            "maxLength": 16,
            "pattern": "^CWE-[0-9]+$(?!\\n)",
            "type": "string"
          },
          "title": "Cwe Ids",
          "type": "array"
        },
        "descriptions": {
          "items": {
            "$ref": "#/$defs/LocalizedText"
          },
          "minItems": 1,
          "title": "Descriptions",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^ev:[0-9a-f]{24}$(?!\\n)",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "formal_seed_eligible": {
          "const": false,
          "default": false,
          "title": "Formal Seed Eligible",
          "type": "boolean"
        },
        "kev": {
          "anyOf": [
            {
              "$ref": "#/$defs/KevEntry"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CISA KEV entry, when a consulted source lists one."
        },
        "last_modified": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^(?:(?!0000)[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?!0000)(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$(?!\\n)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Modified"
        },
        "nvd_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "NVD 2.0 vulnStatus verbatim, untrusted source text; null for NVD 1.1 and synthetic data.",
          "title": "Nvd Status"
        },
        "protocol_design_claim": {
          "const": "not_established",
          "default": "not_established",
          "title": "Protocol Design Claim",
          "type": "string"
        },
        "published": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^(?:(?!0000)[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?!0000)(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$(?!\\n)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published"
        },
        "record_kind": {
          "const": "cve",
          "default": "cve",
          "title": "Record Kind",
          "type": "string"
        },
        "references": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "title": "References",
          "type": "array"
        },
        "vulnerability_origin": {
          "$ref": "#/$defs/VulnerabilityOrigin",
          "default": "unknown"
        }
      },
      "required": [
        "record_kind",
        "cve_id",
        "descriptions",
        "published",
        "last_modified",
        "cvss",
        "cwe_ids",
        "affected",
        "references",
        "kev",
        "nvd_status",
        "cnvd",
        "vulnerability_origin",
        "protocol_design_claim",
        "formal_seed_eligible",
        "evidence_ids"
      ],
      "title": "CveRecord",
      "type": "object"
    },
    "CvssMetric": {
      "additionalProperties": false,
      "properties": {
        "base_score": {
          "maximum": 10.0,
          "minimum": 0.0,
          "title": "Base Score",
          "type": "number"
        },
        "base_severity": {
          "anyOf": [
            {
              "enum": [
                "NONE",
                "LOW",
                "MEDIUM",
                "HIGH",
                "CRITICAL"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Severity"
        },
        "scorer": {
          "description": "Organization that produced this score.",
          "minLength": 1,
          "title": "Scorer",
          "type": "string"
        },
        "scorer_type": {
          "anyOf": [
            {
              "enum": [
                "primary",
                "secondary"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scorer Type"
        },
        "vector_string": {
          "minLength": 1,
          "title": "Vector String",
          "type": "string"
        },
        "version": {
          "enum": [
            "2.0",
            "3.0",
            "3.1",
            "4.0"
          ],
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "vector_string",
        "base_score",
        "base_severity",
        "scorer",
        "scorer_type"
      ],
      "title": "CvssMetric",
      "type": "object"
    },
    "DescriptionMentionBasis": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "description_mention",
          "default": "description_mention",
          "title": "Kind",
          "type": "string"
        },
        "matched_phrase": {
          "description": "Consecutive project-tokenizer tokens.",
          "minLength": 1,
          "title": "Matched Phrase",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "matched_phrase"
      ],
      "title": "DescriptionMentionBasis",
      "type": "object"
    },
    "EvidenceAnchor": {
      "additionalProperties": false,
      "description": "A pointer to one source record, precise enough to re-fetch and re-hash it.",
      "else": {
        "properties": {
          "inference_method": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "assertion_kind": {
            "const": "inferred"
          }
        }
      },
      "properties": {
        "assertion_kind": {
          "$ref": "#/$defs/AssertionKind"
        },
        "authoritative_record_id": {
          "description": "Identifier of the record in its source of record, e.g. a CVE ID.",
          "maxLength": 256,
          "minLength": 1,
          "title": "Authoritative Record Id",
          "type": "string"
        },
        "content_sha256": {
          "description": "SHA-256 of the canonical JSON of the source record this anchor points at.",
          "pattern": "^[0-9a-f]{64}$(?!\\n)",
          "title": "Content Sha256",
          "type": "string"
        },
        "evidence_id": {
          "description": "'ev:' and the first 24 hex digits of the SHA-256 of the canonical JSON of every other anchor field; it changes when any provenance field changes. The server re-derives it and rejects a mismatch. An integrity check, not proof of origin: a holder can recompute it.",
          "pattern": "^ev:[0-9a-f]{24}$(?!\\n)",
          "title": "Evidence Id",
          "type": "string"
        },
        "excerpt": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Bounded excerpt, present only when the source's terms permit redistribution.",
          "title": "Excerpt"
        },
        "inference_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How an inferred anchor was derived; required iff inferred.",
          "title": "Inference Method"
        },
        "license_or_terms_ref": {
          "minLength": 1,
          "title": "License Or Terms Ref",
          "type": "string"
        },
        "locator": {
          "description": "Field path or JSON pointer inside the source.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "pattern": "^(?:(?!0000)[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?!0000)(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$(?!\\n)",
          "title": "Retrieved At",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/KnowledgeScope"
        },
        "source_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Name",
          "type": "string"
        },
        "source_type": {
          "$ref": "#/$defs/SourceType"
        },
        "source_uri": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Source Uri",
          "type": "string"
        },
        "source_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Release, commit, ETag or snapshot identifier, when the source exposes one.",
          "title": "Source Version"
        },
        "trust_level": {
          "$ref": "#/$defs/TrustLevel"
        }
      },
      "required": [
        "evidence_id",
        "source_name",
        "source_type",
        "authoritative_record_id",
        "source_uri",
        "source_version",
        "retrieved_at",
        "content_sha256",
        "locator",
        "excerpt",
        "scope",
        "assertion_kind",
        "inference_method",
        "license_or_terms_ref",
        "trust_level"
      ],
      "then": {
        "properties": {
          "inference_method": {
            "type": "string"
          }
        },
        "required": [
          "inference_method"
        ]
      },
      "title": "EvidenceAnchor",
      "type": "object"
    },
    "KevEntry": {
      "additionalProperties": false,
      "properties": {
        "date_added": {
          "format": "date",
          "pattern": "^(?:(?!0000)[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?!0000)(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)$(?!\\n)",
          "title": "Date Added",
          "type": "string"
        },
        "due_date": {
          "anyOf": [
            {
              "format": "date",
              "pattern": "^(?:(?!0000)[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?!0000)(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)$(?!\\n)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Due Date"
        },
        "known_ransomware_campaign_use": {
          "anyOf": [
            {
              "enum": [
                "known",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CISA's own Known/Unknown assessment; null when the consulted source does not carry it.",
          "title": "Known Ransomware Campaign Use"
        }
      },
      "required": [
        "date_added",
        "due_date",
        "known_ransomware_campaign_use"
      ],
      "title": "KevEntry",
      "type": "object"
    },
    "KnowledgeScope": {
      "description": "What kind of knowledge a record, evidence anchor or claim represents.",
      "enum": [
        "formal_protocol_finding",
        "protocol_threat_context",
        "implementation_vulnerability",
        "unknown"
      ],
      "title": "KnowledgeScope",
      "type": "string"
    },
    "LocalizedText": {
      "additionalProperties": false,
      "properties": {
        "lang": {
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$(?!\\n)",
          "title": "Lang",
          "type": "string"
        },
        "source": {
          "description": "Who authored this text, e.g. a CNA.",
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "value": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "lang",
        "value",
        "source"
      ],
      "title": "LocalizedText",
      "type": "object"
    },
    "NvdVersionHit": {
      "additionalProperties": false,
      "properties": {
        "matched_condition": {
          "$ref": "#/$defs/VersionRange"
        },
        "matched_entry": {
          "$ref": "#/$defs/AffectedProduct"
        },
        "mention": {
          "title": "Mention",
          "type": "string"
        },
        "outcome": {
          "const": "hit",
          "default": "hit",
          "title": "Outcome",
          "type": "string"
        },
        "wording": {
          "title": "Wording",
          "type": "string"
        }
      },
      "required": [
        "mention",
        "outcome",
        "wording",
        "matched_entry",
        "matched_condition"
      ],
      "title": "NvdVersionHit",
      "type": "object"
    },
    "NvdVersionNoHit": {
      "additionalProperties": false,
      "properties": {
        "mention": {
          "title": "Mention",
          "type": "string"
        },
        "outcome": {
          "const": "no_hit",
          "default": "no_hit",
          "title": "Outcome",
          "type": "string"
        },
        "wording": {
          "title": "Wording",
          "type": "string"
        }
      },
      "required": [
        "mention",
        "outcome",
        "wording"
      ],
      "title": "NvdVersionNoHit",
      "type": "object"
    },
    "NvdVersionUnknown": {
      "additionalProperties": false,
      "properties": {
        "mention": {
          "title": "Mention",
          "type": "string"
        },
        "outcome": {
          "const": "unknown",
          "default": "unknown",
          "title": "Outcome",
          "type": "string"
        },
        "reason_code": {
          "enum": [
            "no_matching_product",
            "no_version_condition",
            "version_not_comparable",
            "description_mention_only"
          ],
          "title": "Reason Code",
          "type": "string"
        },
        "wording": {
          "title": "Wording",
          "type": "string"
        }
      },
      "required": [
        "mention",
        "outcome",
        "wording",
        "reason_code"
      ],
      "title": "NvdVersionUnknown",
      "type": "object"
    },
    "ProductFieldBasis": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "product_field",
          "default": "product_field",
          "title": "Kind",
          "type": "string"
        },
        "matched_products": {
          "items": {
            "$ref": "#/$defs/ProductIdentity"
          },
          "minItems": 1,
          "title": "Matched Products",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "matched_products"
      ],
      "title": "ProductFieldBasis",
      "type": "object"
    },
    "ProductIdentity": {
      "additionalProperties": false,
      "description": "One matched vendor:product, with both names case-folded.",
      "properties": {
        "product": {
          "title": "Product",
          "type": "string"
        },
        "vendor": {
          "title": "Vendor",
          "type": "string"
        }
      },
      "required": [
        "vendor",
        "product"
      ],
      "title": "ProductIdentity",
      "type": "object"
    },
    "ProductVulnerability": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "const": "unknown",
          "default": "unknown",
          "title": "Applicability",
          "type": "string"
