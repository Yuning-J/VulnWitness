  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "The requested continuation, or null for the first page.",
      "title": "Cursor"
    },
    "description_mentions_vendor_unconfirmed": {
      "description": "CVEs with no implicated products whose descriptions name the requested product but not the requested vendor as whole-token phrases, excluded across all pages. Zero unless both vendor and product are supplied; mentions do not establish ownership.",
      "minimum": 0,
      "title": "Description Mentions Vendor Unconfirmed",
      "type": "integer"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceAnchor"
      },
      "title": "Evidence",
      "type": "array"
    },
    "items": {
      "description": "Grouping, not ranking: with a version, hit, unknown, then no_hit; then product_field before description_mention, newest published first (missing dates last), then CVE ID ascending. Version never excludes a CVE.",
      "items": {
        "$ref": "#/$defs/ProductVulnerability"
      },
      "maxItems": 20,
      "title": "Items",
      "type": "array"
    },
    "limit": {
      "description": "Requested page size.",
      "maximum": 20,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
    },
    "matched_products": {
      "description": "All matched vendor:product pairs across all pages, sorted by vendor then product. Without a vendor, every matching vendor is included; narrow with vendor.",
      "items": {
        "$ref": "#/$defs/ProductIdentity"
      },
      "title": "Matched Products",
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Opaque continuation, or null on the final page.",
      "title": "Next Cursor"
    },
    "product": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Product"
    },
    "schema_version": {
      "const": "2.0.0-dev.58",
      "default": "2.0.0-dev.58",
      "title": "Schema Version",
      "type": "string"
    },
    "total_available": {
      "description": "Matching CVEs across all pages.",
      "minimum": 0,
      "title": "Total Available",
      "type": "integer"
    },
    "vendor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Vendor"
    },
    "version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Version"
    }
  },
  "required": [
    "schema_version",
    "vendor",
    "product",
    "version",
    "limit",
    "cursor",
    "next_cursor",
    "items",
    "total_available",
    "description_mentions_vendor_unconfirmed",
    "matched_products",
    "evidence"
  ],
  "title": "ProductQueryResponse",
  "type": "object"
}
