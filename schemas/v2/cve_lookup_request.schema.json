{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cve_id": {
      "anyOf": [
        {
          "maxLength": 32,
          "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$(?!\\n)",
          "type": "string"
        },
        {
          "pattern": "^CNVD-[0-9]{4}-[0-9]{4,6}$(?!\\n)",
          "type": "string"
        }
      ],
      "description": "An exact CVE ID or CNVD ID; CNVD IDs resolve to their associated CVE.",
      "title": "Cve Id"
    }
  },
  "required": [
    "cve_id"
  ],
  "title": "CveLookupRequest",
  "type": "object"
}
