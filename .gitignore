# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual envs
.venv/
venv/
env/

# Local settings, which may hold keys (ADR 0004)
.env
.env.*

# OS / IDE
.DS_Store
.idea/
.vscode/

# Logs and temp
*.log
*.tmp
*.swp

# Build outputs
dist/
build/

# Planner evaluation results: the evidence sets hold queries and model plan text
eval-results/

# Real data never enters the repository: raw NVD feeds, KEV catalogs, CNVD Parquet files
# and corpus stores live outside it (docs/runbook.md). The directory guards are rooted
# so tests/contract/data/ stays tracked; file guards catch accidental copies anywhere.
/data/
/stores/
nvdcve-*.json
nvdcve-*.json.gz
nvdcve-*.json.zip
known_exploited_vulnerabilities*.csv
*.parquet
