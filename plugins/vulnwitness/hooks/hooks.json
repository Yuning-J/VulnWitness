{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^mcp__plugin_vulnwitness_vulnwitness__.*$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/record_investigation.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/check_on_stop.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
