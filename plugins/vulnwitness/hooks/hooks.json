{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^mcp__plugin_vulnwitness_vulnwitness__.*$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/vulnwitness-hook\" record-investigation",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/vulnwitness-hook\" check-on-stop",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
